# Variables requeridas por docker-compose.prod.yml en el VPS.
# Copiar a .env (NO versionado) y completar con valores reales.
#
# Nota sobre app_tenant / app_platform: V1__schema_v4.sql crea esos roles
# con un password placeholder (nunca uno real en un script versionado).
# Despues del primer arranque hay que fijar el password real a mano,
# igual que en desarrollo local (ver core-api/README.md paso 3):
#   docker compose -f docker-compose.prod.yml exec postgres \
#     psql -U $POSTGRES_SUPERUSER -d $POSTGRES_DB \
#     -c "ALTER ROLE app_tenant PASSWORD '...';" \
#     -c "ALTER ROLE app_platform PASSWORD '...';"
# Esos passwords deben coincidir con CORE_API_DATASOURCE_PASSWORD y
# ADMIN_API_DATASOURCE_PASSWORD de abajo.

# --- Postgres (produccion) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=cafepos

# --- core-api ---
# No usar "dev": ese perfil habilita Swagger y otros overrides pensados
# solo para desarrollo local. "prod" usa los defaults de application.yml.
CORE_API_SPRING_PROFILES_ACTIVE=prod

# Conexion de runtime — rol app_tenant (sin BYPASSRLS), contra el servicio
# "postgres" por nombre de red docker, nunca localhost.
CORE_API_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cafepos
CORE_API_DATASOURCE_USERNAME=app_tenant
CORE_API_DATASOURCE_PASSWORD=

# Conexion separada para Flyway — superusuario, mismo patron de dos
# usuarios que application-dev.yml (spring.flyway.* != spring.datasource.*)
CORE_API_FLYWAY_URL=jdbc:postgresql://postgres:5432/cafepos
CORE_API_FLYWAY_USER=postgres
CORE_API_FLYWAY_PASSWORD=

# Llave de firma JWT de core-api — nunca la de dev, generar una nueva
CAFEPOS_CORE_JWT_SIGNING_KEY=

# --- admin-api ---
ADMIN_API_SPRING_PROFILES_ACTIVE=prod

# Conexion de runtime — rol app_platform (BYPASSRLS), nunca app_tenant
ADMIN_API_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cafepos
ADMIN_API_DATASOURCE_USERNAME=app_platform
ADMIN_API_DATASOURCE_PASSWORD=

# Llave de firma JWT de admin-api — distinta a la de core-api, nunca la de dev
CAFEPOS_ADMIN_JWT_SIGNING_KEY=

# Llave de cifrado AES-256 (32 bytes en Base64) para credenciales Factus/DIAN
# CRITICO: debe ser EXACTAMENTE la misma en core-api y admin-api
CAFEPOS_FACTUS_ENCRYPTION_KEY=

# Dominio publico base para resolver subdominios de negocios/tenants
CAFEPOS_TENANT_BASE_DOMAIN=resttodash.app
